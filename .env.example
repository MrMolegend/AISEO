# ─────────────────────────────────────────────────────────────────────────────
# AISEO environment
#
# Every value below is OPTIONAL for local development. With an empty .env the app
# runs end-to-end using the mock AI provider and the in-memory storage driver, so
# you can build and test the whole pipeline without a single external account.
#
# Copy to .env.local and fill in only what you need.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI ───────────────────────────────────────────────────────────────────────
# "mock" returns a deterministic fixture audit — no network, no cost.
# "anthropic" makes real API calls and requires ANTHROPIC_API_KEY.
AI_PROVIDER=mock
AI_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-...

# ── Storage (Supabase) ───────────────────────────────────────────────────────
# Omit all three to use the in-memory storage driver. Audits will not survive a
# server restart, which is fine for local work but never for production.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Rate limiting & cache (Upstash Redis) ────────────────────────────────────
# Omit both to use the in-process limiter. Correct for a single local process;
# NOT correct in production, where instances do not share memory.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Abuse & cost controls ────────────────────────────────────────────────────
# IP_HASH_SALT must be set to a real random value in production; IPs are only
# ever stored as salted hashes.
IP_HASH_SALT=dev-only-salt-change-in-production
AUDIT_RATE_LIMIT_PER_HOUR=3
AUDIT_RATE_LIMIT_PER_DAY=10
AUDIT_DAILY_GLOBAL_CAP=200
AUDIT_CACHE_TTL_HOURS=24

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
