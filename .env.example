# ═══════════════════════════════════════════════════════════════════════════
# Environment
#
# Copy to .env.local and fill in what you need. Every variable is validated at
# boot by lib/env.ts, so a typo fails immediately with the variable's name
# rather than surfacing later as an undefined-property crash.
#
# Nothing here is required to start the application. Each subsystem falls back
# to a development driver and says which one it is using. /api/health reports
# the live driver for every subsystem, and refuses to call production healthy
# while a mock is serving research.
#
# NEVER commit real values. This file holds names and shapes only.
# ═══════════════════════════════════════════════════════════════════════════


# ── Site ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ── Authentication + storage: Supabase ─────────────────────────────────────
# One project serves both. The publishable key is browser-safe and is used only
# for Supabase Auth; the service-role key is server-only, bypasses RLS, and must
# never reach a browser bundle.
#
# Older projects expose the browser-safe key as NEXT_PUBLIC_SUPABASE_ANON_KEY.
# Either name works — the application resolves whichever is present.
#
# The two NEXT_PUBLIC_ values must be present at BUILD time, not just at
# runtime: they are inlined into the client bundle, and the CSP that lets the
# browser reach Supabase at all is baked during `next build`.
#
# Email links will not work until the Supabase dashboard is configured to match
# — Site URL, redirect allow list and all four email templates. See
# "Supabase dashboard checklist" in ARCHITECTURE.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ── Web research provider ──────────────────────────────────────────────────
# Answers "what is published about this subject?".
#
#   mock    deterministic fixture data. Correct for tests and local work.
#           /api/health reports production as degraded while this is active,
#           because a mock that ships quietly is worse than a missing key: it
#           produces plausible output nobody questions.
#   tavily  https://tavily.com — requires an account and an API key.
RESEARCH_PROVIDER=mock
TAVILY_API_KEY=


# ── AI provider: Anthropic ─────────────────────────────────────────────────
#   mock       fixture reports. No key, no cost. Used by CI and every test.
#   anthropic  real synthesis. Requires ANTHROPIC_API_KEY.
AI_PROVIDER=mock
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=


# ── Rate limiting and caching: Upstash Redis ───────────────────────────────
# Absent, limits fall back to an in-process driver that is correct for a single
# instance and useless across several. Fine locally; not fine in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ── Abuse and cost controls ────────────────────────────────────────────────
# Salt for hashing IP addresses. Raw addresses are never stored.
IP_HASH_SALT=change-me-to-a-long-random-string

RESEARCH_RATE_LIMIT_PER_HOUR=6
RESEARCH_RATE_LIMIT_PER_DAY=20
# Whole-service daily ceiling. Set this before the first public link goes out.
RESEARCH_DAILY_GLOBAL_CAP=200
# How long a completed report satisfies an identical request from the same user.
RESEARCH_CACHE_TTL_HOURS=24


# ── Tokens ─────────────────────────────────────────────────────────────────
# Granted once, on first sign-in. Leave at 0 in production: an account that
# silently receives spendable credit is a cost leak. A non-zero value is a
# convenience for local work so a fresh developer can run a report immediately.
WELCOME_TOKEN_GRANT=0

# Shared secret for the operator token-grant route. Absent, that route is
# disabled outright rather than left open. Minimum 24 characters.
# See "Granting tokens" in the README.
ADMIN_GRANT_SECRET=


# ── Test escape hatches ────────────────────────────────────────────────────
# Replaces Supabase Auth with an in-memory session so the end-to-end suite can
# open a browser on the signed-in surface. NEVER set this on a deployment: the
# application refuses to start if it is set alongside real Supabase credentials
# or on a production deployment.
# AUTH_TEST_DRIVER=1

# Lets the SSRF guard accept loopback targets so tests can run against a local
# server. Production must never set this.
# E2E_ALLOW_LOCAL_FETCH=1

LOG_LEVEL=info
