    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.33.0",
    "nanoid": "^6.0.1",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
